# --- Armazenamento ---
# Com DATABASE_URL: pgvector (docker compose up -d). Sem: NCMs + embeddings dos arquivos em data/.
DATABASE_URL=postgres://ncm:ncm@localhost:5432/ncm

# --- Embeddings ---
# voyage (padrão quando VOYAGE_API_KEY existe) | local (multilingual-e5-small via ONNX, offline)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3
# LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small

# --- Reranker (LLM) ---
# claude (padrão quando há ANTHROPIC_API_KEY) | gemini (padrão quando há só GEMINI_API_KEY)
# | claude-cli (Claude Code local, plano do usuário; só para avaliação) | groq | openrouter | ollama | openai-compat | noop (só vetorial)
# CLAUDE_CLI_MODEL=haiku
# RERANKER=gemini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium   # low | medium | high | xhigh | max

# Provedores OpenAI-compatíveis (Gemini tem plano gratuito: aistudio.google.com → API keys)
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite   # sobrescreve o modelo padrão do preset
# LLM_BASE_URL=                     # obrigatório com RERANKER=openai-compat
# LLM_RPM=12                        # pnpm eval: limite de chamadas/minuto (planos gratuitos)
# LLM_CONCORRENCIA=2                # pnpm eval: chamadas simultâneas
# K_LLM=20                          # pnpm eval: candidatos enviados ao LLM

# --- API ---
# PORT=3333
